---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import ValueTable from '../components/ValueTable.astro';
import { loadBuildData } from '../lib/build-data';
import {
  CBS_DATASET_TITLE,
  CBS_DATASET_URL,
  CBS_INDEX_DATASET_URL,
  CBS_INDEX_TITLE,
  EURO_INTRODUCTION_YEAR,
  FIRST_MONTHLY_YEAR,
  FIRST_YEAR,
  euroToGuilderConversionRate,
  formatMoney,
} from '../lib/inflation';
import { homePageSchema, webApplicationSchema, websiteSchema } from '../lib/schema';
import { focusRing, linkClass } from '../lib/ui';
import { yearPagePath } from '../lib/year-pages';

// Built from CBS data fetched once per build (see build-data.ts). The
// calculator embeds the same copy, so the browser never contacts CBS.
const { data, datasetModified } = await loadBuildData();

const defaultAmount = 100;
const endYear = data.latestYear;
const startYear = endYear - 10;
const month = data.latestMonth;
const latestPeriod = data.latestPeriodLabel;
const latestYearlyYear = data.latestYearlyYear;
const updatedOn = datasetModified.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Amsterdam' });

// The table compares yearly averages (exact, from 1900) with the latest
// complete year. Euro years, then guilder years with the oldest ones folded
// away (still in the HTML, so still indexed) to keep the page short.
const historicalValues = data.historicalValues(defaultAmount);
const OLDER_GUILDER_YEARS_BEFORE = 1980;
const euroRows = historicalValues.filter(row => row.year >= EURO_INTRODUCTION_YEAR);
const guilderRows = historicalValues.filter(row => row.year < EURO_INTRODUCTION_YEAR && row.year >= OLDER_GUILDER_YEARS_BEFORE);
const olderGuilderRows = historicalValues.filter(row => row.year < OLDER_GUILDER_YEARS_BEFORE);
const tableCaption = (currency: string) => `Waarde van ${currency} ${defaultAmount} per jaar, omgerekend naar ${latestYearlyYear}`;

// A concrete example for the gulden question in the FAQ.
const guilderExample = historicalValues.find(row => row.year === 1980);
const guilderRate = euroToGuilderConversionRate.toLocaleString('nl-NL', { maximumFractionDigits: 5 });

const title = 'Inflatie Berekenen – Koopkracht van Gulden en Euro sinds 1900';
const description = 'Bereken wat een bedrag van vroeger nu waard is. Gratis inflatiecalculator voor gulden en euro, met officiële CBS-cijfers van 1900 tot nu.';

const datasetLinkText = `“${CBS_DATASET_TITLE}”`;
const indexLinkText = `“${CBS_INDEX_TITLE}”`;
---

<Layout
  title={title}
  description={description}
  socialTitle="Inflatie Berekenen – wat is je geld van vroeger nu waard?"
  socialDescription="Gratis inflatiecalculator voor gulden en euro, met officiële CBS-cijfers van 1900 tot nu."
  jsonLd={[
    websiteSchema(Astro.site!),
    homePageSchema({ name: title, description, dateModified: datasetModified, site: Astro.site! }),
    webApplicationSchema(Astro.site!, datasetModified),
  ]}
>
  <main class="flex items-center justify-center p-4 lg:px-6 lg:pt-6">
    <div class="container grid max-w-7xl gap-4 lg:gap-8 lg:grid-cols-2">
      <Calculator
        data={data}
        datasetModified={datasetModified}
        amount={defaultAmount}
        startYear={startYear}
        endYear={endYear}
        month={month}
        heading="Inflatie Berekenen"
        intro={`Bereken wat een bedrag van vroeger nu waard is, in guldens en euro's, met officiële CBS-cijfers sinds ${FIRST_YEAR}.`}
      />

      <section class="flex rounded-md border border-blue-200 lg:col-span-2" aria-labelledby="historical-values-title">
        <div class="flex-1 p-6 lg:p-8">
          <h2 id="historical-values-title" class="text-xl font-bold mb-2">Wat is geld van vroeger nu waard?</h2>
          <p class="mb-2">
            Hoeveel is {defaultAmount} gulden of {defaultAmount} euro uit een bepaald jaar vandaag waard?
            De tabellen hieronder geven het antwoord voor elk jaar sinds {FIRST_YEAR}, omgerekend naar {latestYearlyYear}.
            Vergeleken worden de jaargemiddelden, want {latestYearlyYear} is het meest recente volledige jaar.
            Voor een ander bedrag, jaar of een recente maand gebruik je de calculator bovenaan.
          </p>
          <p class="mb-6 text-gray-700">
            <strong>Prijsstijging</strong> is hoeveel duurder alles sindsdien is geworden.
            Bij guldens is het bedrag in de kolom <strong>In {latestYearlyYear}</strong> daarnaast omgerekend naar euro's, tegen {guilderRate} gulden per euro. Daarom is het bedrag in euro's lager dan de prijsstijging doet vermoeden.
          </p>

          <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
            <div>
              <h3 class="font-semibold mb-2">Euro ({euroRows[0]?.year}–{euroRows.at(-1)?.year})</h3>
              <ValueTable caption={tableCaption('€')} amount={defaultAmount} endYear={latestYearlyYear} rows={euroRows} linkYears />
            </div>

            <div>
              <h3 class="font-semibold mb-2">Gulden naar euro ({olderGuilderRows[0]?.year ?? guilderRows[0]?.year}–{guilderRows.at(-1)?.year})</h3>
              <ValueTable caption={tableCaption('ƒ')} amount={defaultAmount} endYear={latestYearlyYear} rows={guilderRows} linkYears />
              {olderGuilderRows.length > 0 && (
                <details class="mt-2">
                  <summary class={`cursor-pointer py-2 font-semibold text-blue-700 ${focusRing}`}>
                    Toon {olderGuilderRows[0].year}–{olderGuilderRows.at(-1)!.year}
                  </summary>
                  <ValueTable caption={tableCaption('ƒ')} amount={defaultAmount} endYear={latestYearlyYear} rows={olderGuilderRows} linkYears />
                </details>
              )}
            </div>
          </div>
        </div>
      </section>

      <section class="flex rounded-md border border-blue-200 lg:col-span-2" aria-labelledby="about-title">
        <div class="flex-1 p-6 lg:p-8">
          <h2 id="about-title" class="text-xl font-bold">Over deze inflatiecalculator</h2>
          <div class="mt-2 max-w-3xl">
            <p class="mb-2">
              Door inflatie wordt geld steeds minder waard: voor hetzelfde bedrag koop je minder dan vroeger.
              Met deze calculator zie je wat een bedrag uit het verleden vandaag waard is, en hoeveel koopkracht
              het door de jaren heen heeft verloren.
            </p>

            <p class="mb-2">
              De berekening gebruikt de officiële cijfers van het Centraal Bureau voor de Statistiek (CBS).
              Voor jaargemiddelden vanaf {FIRST_YEAR} is dat de prijsindex <a href={CBS_INDEX_DATASET_URL} target="_blank" rel="noopener noreferrer" class={linkClass}>{indexLinkText}</a>.
              Voor maanden, vanaf januari {FIRST_MONTHLY_YEAR} tot en met {latestPeriod}, zijn dat de cijfers uit <a href={CBS_DATASET_URL} target="_blank" rel="noopener noreferrer" class={linkClass}>{datasetLinkText}</a>.
              Bedragen van vóór {EURO_INTRODUCTION_YEAR} worden omgerekend naar euro's tegen de vaste koers van {guilderRate} gulden per euro.
            </p>

            <p>
              Gemaakt door <a href="https://nickhuijgen.nl/" class={linkClass}>Nick Huijgen</a>.
              De <a href="https://github.com/NickHuijgen/inflatie-calculator" target="_blank" rel="noopener noreferrer" class={linkClass}>broncode en de volledige berekening staan op GitHub</a>.
            </p>
          </div>
        </div>
      </section>

      <section class="flex rounded-md border border-blue-200 lg:col-span-2" aria-labelledby="faq-title">
        <div class="flex-1 p-6 lg:p-8">
          <h2 id="faq-title" class="text-xl font-bold mb-4">Veelgestelde vragen</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h3 class="font-semibold">Wat is inflatie?</h3>
              <p>
                Inflatie is de stijging van prijzen in de loop van de tijd. Daardoor wordt je geld minder waard:
                met hetzelfde bedrag koop je minder producten en diensten dan voorheen.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Waarom is inflatie belangrijk?</h3>
              <p>
                Inflatie bepaalt wat je inkomen en spaargeld echt waard zijn. Stijgen je loon of je spaarrente minder
                hard dan de prijzen, dan ga je er in koopkracht op achteruit, ook als het bedrag op papier gelijk blijft.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Wat is een gulden van vroeger nu waard?</h3>
              <p>
                Dat hangt af van het jaar. De vaste omrekenkoers is {guilderRate} gulden voor 1 euro, maar daarmee
                reken je alleen de munt om, niet de inflatie.
                {guilderExample && (
                  <Fragment>
                    Rekening houdend met inflatie had <a href={yearPagePath(guilderExample.year)} class={linkClass}>ƒ {defaultAmount} uit {guilderExample.year}</a> in {latestYearlyYear} de koopkracht van {formatMoney(guilderExample.value, latestYearlyYear)}.
                  </Fragment>
                )}
                Kijk in de <a href="#historical-values-title" class={linkClass}>tabel met alle jaren</a> of vul je eigen bedrag in de calculator in.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Hoe wordt inflatie gemeten?</h3>
              <p>
                Met de consumentenprijsindex (CPI) van het CBS. Die volgt de prijzen van een vast pakket goederen en
                diensten dat huishoudens kopen, zoals boodschappen, energie, huur en kleding. De inflatie is hoeveel
                procent dat pakket duurder is geworden ten opzichte van een jaar eerder.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Hoe rekent deze calculator?</h3>
              <p>
                Bij jaargemiddelden vergelijkt de calculator het prijspeil van het CBS in beide jaren: is dat
                2,5 keer zo hoog, dan heb je 2,5 keer zoveel geld nodig voor hetzelfde. Bij een maand telt hij de
                inflatie van elk jaar voor die maand bij elkaar op, met rente op rente. Het gemiddelde per jaar is
                ook samengesteld: de vaste jaarlijkse inflatie die op hetzelfde totaal uitkomt. Bij bedragen van
                vóór {EURO_INTRODUCTION_YEAR} rekent hij ook om van gulden naar euro.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Wat is het verschil tussen een maand en het jaargemiddelde?</h3>
              <p>
                Kies je een maand, dan vergelijkt de calculator die maand in het beginjaar met dezelfde maand in het
                eindjaar. Het jaargemiddelde kijkt naar het hele jaar en is daardoor minder gevoelig voor uitschieters.
                Maandcijfers zijn er vanaf {FIRST_MONTHLY_YEAR}; daarvoor alleen jaargemiddelden. Voor het lopende jaar is
                nog geen jaargemiddelde beschikbaar.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Waar komen de cijfers vandaan?</h3>
              <p>
                Van het Centraal Bureau voor de Statistiek (CBS), de officiële statistische dienst van Nederland.
                De calculator gebruikt de CBS-tabellen <a href={CBS_INDEX_DATASET_URL} target="_blank" rel="noopener noreferrer" class={linkClass}>{indexLinkText}</a> en <a href={CBS_DATASET_URL} target="_blank" rel="noopener noreferrer" class={linkClass}>{datasetLinkText}</a>.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Over welke periode kan ik rekenen?</h3>
              <p>
                Met jaargemiddelden van {FIRST_YEAR} tot en met {latestYearlyYear}.
                Per maand van januari {FIRST_MONTHLY_YEAR} tot en met de meest recente maand die het CBS heeft gepubliceerd; nu is dat {latestPeriod}.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Worden de cijfers bijgewerkt?</h3>
              <p>
                Ja. Het CBS publiceert elke maand nieuwe inflatiecijfers, en deze site haalt ze elke dag op.
                Nieuwe cijfers staan er dus binnen een dag op. De laatste update van het CBS was op {updatedOn}.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Hoe betrouwbaar is de uitkomst?</h3>
              <p>
                De berekening gebruikt de officiële CBS-cijfers en de broncode is openbaar, dus je kunt alles
                controleren. Houd er wel rekening mee dat het om gemiddelden gaat: je persoonlijke inflatie kan
                afwijken, afhankelijk van waar je je geld aan uitgeeft.
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="flex justify-center w-full mb-4">
    <p class="text-gray-700 w-fit">
      Gemaakt door <a href="https://nickhuijgen.nl/" class={linkClass}>Nick Huijgen</a>
    </p>
  </footer>

</Layout>
