---
import Layout from '../layouts/Layout.astro';
import {
  CBS_DATASET_URL,
  EURO_INTRODUCTION_YEAR,
  MONTHS,
  fetchInflationData,
  formatAmount,
  formatMoney,
  formatPercent,
} from '../lib/inflation';

// Fetched at build time so the default result and the table below are in
// the static HTML (for search engines, and so nothing shifts on load). The
// browser fetches fresh data again on every visit; a scheduled rebuild
// keeps this copy current (see Hosting in AGENTS.md). If CBS is down, the
// build fails and the previous deployment stays live.
const data = await fetchInflationData();

const defaultAmount = 100;
const endYear = data.latestYear;
const startYear = endYear - 10;
const month = data.latestMonth;
const latestPeriod = data.latestPeriodLabel;
const latestPeriodShort = (month !== 'JJ00' ? `${month.substring(2)}-` : '') + endYear;

const defaultResult = {
  input: formatMoney(defaultAmount, startYear),
  output: formatMoney(data.output(defaultAmount, startYear, endYear, month), endYear),
  inflation: formatPercent(data.inflationPercentage(startYear, endYear, month)),
  average: formatPercent(data.averageInflation(startYear, endYear, month)),
};

const historicalValues = data.historicalValues(defaultAmount);
const valueTables = [
  {
    title: 'Guldens van vroeger',
    currency: 'ƒ',
    rows: historicalValues.filter(row => row.year < EURO_INTRODUCTION_YEAR),
  },
  {
    title: "Euro's van vroeger",
    currency: '€',
    rows: historicalValues.filter(row => row.year >= EURO_INTRODUCTION_YEAR),
  },
];

const inputClass = 'bg-gray-100 px-4 py-2 outline-hidden rounded-md w-full disabled:opacity-60';
const labelClass = 'block mb-1 font-semibold text-gray-700';
const linkClass = 'text-blue-700 underline-offset-2 hover:underline';
const datasetLinkText = 'CBS-dataset “Jaarmutatie consumentenprijsindex; vanaf 1963”';
---

<Layout
  title="Inflatie Berekenen - Bereken Koopkracht en Inflatie in Nederland"
  description="Bereken eenvoudig inflatie en koopkracht in Nederland vanaf 1963. Gratis inflatie calculator voor gulden en euro met actuele CBS data."
  socialTitle="Inflatie Berekenen - Bereken Koopkracht en Inflatie"
  socialDescription="Bereken eenvoudig inflatie en koopkracht in Nederland vanaf 1963."
>
  <main class="flex items-center justify-center p-4 lg:px-6 lg:pt-6">
    <div class="container grid max-w-7xl gap-4 lg:gap-8 lg:grid-cols-2 lg:grid-rows-2">
      <section class="row-span-2 flex flex-col rounded-md border border-blue-200" aria-label="Calculator">
        <form id="calculator" class="p-6 lg:p-8" novalidate>
          <h1 class="text-xl font-bold">Inflatie Berekenen</h1>
          <div class="mt-2">
            <div class="py-2">
              <label for="input-amount" class={labelClass}>Bedrag</label>
              <input id="input-amount" name="amount" type="text" inputmode="decimal" autocomplete="off" value={formatAmount(defaultAmount)} disabled class={inputClass} />
            </div>

            <div class="py-2">
              <label for="input-start-year" class={labelClass}>Beginjaar</label>
              <input id="input-start-year" name="startYear" type="number" inputmode="numeric" value={startYear} disabled class={inputClass} />
            </div>

            <div class="py-1 ml-1.5">
              <button id="switch-years" type="button" class="flex size-11 cursor-pointer items-center justify-center rounded-md hover:bg-gray-100" aria-label="Wissel begin- en eindjaar">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5L7.5 3m0 0L12 7.5M7.5 3v13.5m13.5 0L16.5 21m0 0L12 16.5m4.5 4.5V7.5" />
                </svg>
              </button>
            </div>

            <div class="py-2">
              <label for="input-end-year" class={labelClass}>Eindjaar</label>
              <input id="input-end-year" name="endYear" type="number" inputmode="numeric" value={endYear} disabled class={inputClass} />
            </div>

            <div class="py-2">
              <label for="select-month" class={labelClass}>Maand</label>
              <select id="select-month" name="month" class={inputClass}>
                {MONTHS.map(([value, label]) => <option value={value} selected={value === month}>{label}</option>)}
              </select>
            </div>
          </div>
        </form>
      </section>

      <section class="flex rounded-md border border-blue-200" aria-label="Resultaten">
        <div class="flex-1 p-6 lg:p-8">
          <h2 class="text-xl font-bold">Resultaten</h2>
          <div class="mt-2" aria-live="polite">
            <div id="result">
              <p class="mb-2">
                <strong id="result-input">{defaultResult.input}</strong> had in <span id="result-start-year">{startYear}</span> dezelfde koopkracht als <strong id="result-output">{defaultResult.output}</strong> in <span id="result-end-year">{endYear}</span>
              </p>
              <p class="mb-2">
                Dat is een totale inflatie van <strong><span id="result-inflation">{defaultResult.inflation}</span>%</strong>
              </p>
              <p>
                Gemiddeld <strong><span id="result-average">{defaultResult.average}</span>%</strong> per jaar
              </p>
            </div>
            <p id="result-invalid" hidden>Vul alstublieft geldige waarden in</p>
            <p id="result-error" hidden>De gegevens van het CBS konden niet worden geladen. Probeer het later opnieuw.</p>
          </div>
        </div>
      </section>

      <section class="flex rounded-md border border-blue-200" aria-label="Informatie">
        <div class="flex-1 p-6 lg:p-8">
          <h2 class="text-xl font-bold">Informatie</h2>
          <div class="mt-2">
            <p class="mb-2">
              Inflatie zorgt ervoor dat geld steeds minder waard wordt. Met deze inflatiecalculator bereken je eenvoudig
              hoeveel koopkracht je door de jaren heen hebt verloren.
            </p>

            <p class="mb-2">
              De berekening is gebaseerd op officiële inflatiecijfers van het Centraal Bureau voor de Statistiek (CBS),
              afkomstig uit de <a href={CBS_DATASET_URL} target="_blank" rel="noopener noreferrer" class={linkClass}>{datasetLinkText}</a>.
              Data is beschikbaar vanaf 01-1963 tot en met <span id="latest-period">{latestPeriodShort}</span>.
            </p>

            <p class="mb-4">
              De volledige broncode en berekening zijn te vinden op <a
                href="https://github.com/NickHuijgen/inflatie-calculator"
                target="_blank"
                rel="noopener noreferrer"
                class={linkClass}
              >GitHub (inflatie-calculator)</a>.
            </p>
          </div>
        </div>
      </section>

      <section class="flex rounded-md border border-blue-200 lg:col-span-2" aria-labelledby="historical-values-title">
        <div class="flex-1 p-6 lg:p-8">
          <h2 id="historical-values-title" class="text-xl font-bold mb-2">Wat is geld van vroeger nu waard?</h2>
          <p class="mb-6">
            Hoeveel is {defaultAmount} gulden of {defaultAmount} euro uit een bepaald jaar vandaag waard?
            Per jaar sinds {valueTables[0].rows[0]?.year} zie je wat hetzelfde bedrag in {latestPeriod} waard is,
            en hoeveel de prijzen sindsdien gestegen zijn.
            Voor jaren vóór {EURO_INTRODUCTION_YEAR} is het bedrag in guldens en omgerekend naar euro's.
            Vergeleken wordt steeds {month === 'JJ00' ? 'het jaargemiddelde' : `de maand ${latestPeriod.split(' ')[0]}`} van elk jaar.
          </p>

          <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
            {valueTables.map(table => (
              <div>
                <h3 class="font-semibold mb-2">{table.title}</h3>
                <table class="w-full text-left tabular-nums">
                  <caption class="sr-only">{table.title}: waarde van {table.currency}{defaultAmount} in {latestPeriod}</caption>
                  <thead>
                    <tr class="border-b border-blue-200">
                      <th scope="col" class="py-2 pr-2 font-semibold">Jaar</th>
                      <th scope="col" class="py-2 pr-2 font-semibold">Toen</th>
                      <th scope="col" class="py-2 pr-2 font-semibold">Nu waard</th>
                      <th scope="col" class="py-2 text-right font-semibold">Inflatie</th>
                    </tr>
                  </thead>
                  <tbody>
                    {table.rows.map(row => (
                      <tr class="border-b border-gray-100">
                        <th scope="row" class="py-1.5 pr-2 font-normal">{row.year}</th>
                        <td class="py-1.5 pr-2">{formatMoney(defaultAmount, row.year)}</td>
                        <td class="py-1.5 pr-2 font-semibold">{formatMoney(row.value, endYear)}</td>
                        <td class="py-1.5 text-right">{formatPercent(row.inflation)}%</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="flex rounded-md border border-blue-200 lg:col-span-2" aria-label="FAQ">
        <div class="flex-1 p-6 lg:p-8">
          <h2 class="text-xl font-bold mb-4">Veelgestelde vragen</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h3 class="font-semibold">Wat is inflatie?</h3>
              <p class="mb-3">
                Inflatie betekent dat prijzen stijgen en je geld minder waard wordt. Hierdoor kun je met hetzelfde bedrag
                minder producten en diensten kopen dan voorheen.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Waarom is inflatie belangrijk?</h3>
              <p class="mb-3">
                Inflatie heeft invloed op je koopkracht, spaargeld en inkomen. Bij hoge inflatie daalt de waarde van spaargeld
                sneller en worden dagelijkse uitgaven duurder.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Hoe wordt inflatie berekend?</h3>
              <p class="mb-3">
                Inflatie wordt berekend op basis van de consumentenprijsindex (CPI). Deze index meet de gemiddelde
                prijsontwikkeling van een vast pakket aan goederen en diensten.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Wat is de consumentenprijsindex (CPI)?</h3>
              <p class="mb-3">
                De CPI is een maatstaf die laat zien hoe prijzen van alledaagse producten, zoals boodschappen, energie en
                wonen, zich in de loop van de tijd ontwikkelen.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Waar komen de inflatiecijfers vandaan?</h3>
              <p class="mb-3">
                De inflatiecijfers op deze website zijn afkomstig van het Centraal Bureau voor de Statistiek (CBS),
                de officiële statistische instantie van Nederland.
                Er wordt gebruikgemaakt van de <a href={CBS_DATASET_URL} target="_blank" rel="noopener noreferrer" class={linkClass}>{datasetLinkText}</a>.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Wat kan ik berekenen met deze inflatiecalculator?</h3>
              <p class="mb-3">
                Met deze inflatiecalculator kun je berekenen hoeveel een bedrag uit het verleden vandaag waard zou zijn,
                of hoeveel koopkracht je door inflatie bent verloren.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Is deze inflatiecalculator betrouwbaar?</h3>
              <p class="mb-3">
                Ja, de berekening is gebaseerd op officiële CBS-inflatiecijfers en volgt een transparante rekenmethode.
                De volledige broncode is openbaar beschikbaar op GitHub.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Vanaf welk jaar is inflatie te berekenen?</h3>
              <p class="mb-3">
                De beschikbare inflatiegegevens lopen vanaf januari 1963 tot en met het meest recente jaar waarvoor
                CBS-data beschikbaar is.
              </p>
            </div>

            <div>
              <h3 class="font-semibold">Worden de inflatiecijfers bijgewerkt?</h3>
              <p>
                Ja, zodra het CBS nieuwe inflatiecijfers publiceert, worden deze automatisch verwerkt in de
                inflatiecalculator.
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="flex justify-center w-full mb-2">
    <p class="text-gray-800 w-fit">
      Gemaakt door Nick Huijgen
    </p>
  </footer>
</Layout>

<script>
  import '../scripts/calculator';
</script>
