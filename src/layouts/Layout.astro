---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  socialTitle?: string;
  socialDescription?: string;
  // For pages that must not be indexed (the 404): adds robots noindex and
  // drops canonical, og:/twitter: tags and the JSON-LD.
  noindex?: boolean;
  // Structured data for this page, built with src/lib/schema.ts. Required
  // unless `noindex`.
  jsonLd?: Record<string, unknown>[];
}

const { title, description, socialTitle = title, socialDescription = description, noindex = false, jsonLd = [] } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="author" content="Nick Huijgen" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <meta property="og:title" content={socialTitle} />
        <meta property="og:description" content={socialDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Inflatie Berekenen: wat is je geld van vroeger nu waard?" />
        <meta property="og:locale" content="nl_NL" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={socialTitle} />
        <meta name="twitter:description" content={socialDescription} />
        <link rel="canonical" href={canonicalUrl} />
        {jsonLd.map(item => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
