---
import {
  EURO_INTRODUCTION_YEAR,
  FIRST_MONTHLY_YEAR,
  FIRST_YEAR,
  MONTHS,
  formatAmount,
  formatMoney,
  formatPercent,
  type InflationData,
} from '../lib/inflation';
import { cardClass, focusRing, hintClass, inputClass, labelClass } from '../lib/ui';
import { embedJson } from '../lib/embed';

// The calculator form and its result card: two grid children, rendered with
// the given defaults as static HTML (search engines and no-JS visitors see a
// real result) and made interactive by src/scripts/calculator.ts, which reads
// those defaults back from the DOM. Only one per page: the script and the
// element ids assume it.
interface Props {
  data: InflationData;
  datasetModified: Date;
  amount: number;
  startYear: number;
  endYear: number;
  month: string;
  heading: string;
  headingTag?: 'h1' | 'h2';
  intro?: string;
}

const { data, datasetModified, amount, startYear, endYear, month, heading, headingTag: Heading = 'h1', intro } = Astro.props;

const maxYear = data.latestYear;
const updatedOn = datasetModified.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Amsterdam' });

const output = data.output(amount, startYear, endYear, month);

// `!(output > 0)` rather than `< 0`: a missing figure returns -1, but NaN and
// Infinity fail a `< 0` test and would reach the page as "€ NaN" / "€ ∞".
if (!(output > 0)) {
  throw new Error(`Calculator defaults have no CBS figures: ${startYear} → ${endYear}, ${month}`);
}

// Like the script (calculator.ts), the price change is described forwards in
// time whichever order the years arrive in -- the spans below are labelled
// with min/max, so computing it in the given order would make the static HTML
// contradict itself the moment the years were passed the other way round.
const fromYear = Math.min(startYear, endYear);
const toYear = Math.max(startYear, endYear);
const inflation = data.inflationPercentage(fromYear, toYear, month);
const result = {
  input: formatMoney(amount, startYear),
  output: formatMoney(output, endYear),
  direction: inflation < 0 ? 'daalden' : 'stegen',
  inflation: formatPercent(Math.abs(inflation)),
  average: formatPercent(data.averageInflation(fromYear, toYear, month)),
};
---

<section class={`flex flex-col ${cardClass}`} aria-labelledby="calculator-title">
  <form id="calculator" class="p-6 lg:p-8" novalidate>
    <Heading id="calculator-title" class={Heading === 'h1' ? 'text-2xl font-bold' : 'text-xl font-bold'}>{heading}</Heading>
    {intro && <p class="mt-1 text-gray-700">{intro}</p>}

    <div class="mt-4 space-y-4">
      <div>
        <label for="input-amount" class={labelClass}>Bedrag</label>
        <input id="input-amount" name="bedrag" type="text" inputmode="decimal" autocomplete="off" value={formatAmount(amount)} aria-describedby="hint-amount" class={inputClass} />
        <p id="hint-amount" class={hintClass}>Vóór {EURO_INTRODUCTION_YEAR} in guldens, daarna in euro's.</p>
      </div>

      <div>
        <div class="grid grid-cols-[1fr_auto_1fr] items-end gap-2">
          <div>
            <label for="input-start-year" class={labelClass}>Van jaar</label>
            <input id="input-start-year" name="van" type="number" inputmode="numeric" min={FIRST_YEAR} max={maxYear} value={startYear} aria-describedby="hint-years" class={inputClass} />
          </div>
          <button id="switch-years" type="button" class={`flex size-11 cursor-pointer items-center justify-center rounded-md hover:bg-gray-100 ${focusRing}`} aria-label="Wissel de jaren om">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 rotate-90" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5L7.5 3m0 0L12 7.5M7.5 3v13.5m13.5 0L16.5 21m0 0L12 16.5m4.5 4.5V7.5" />
            </svg>
          </button>
          <div>
            <label for="input-end-year" class={labelClass}>Naar jaar</label>
            <input id="input-end-year" name="naar" type="number" inputmode="numeric" min={FIRST_YEAR} max={maxYear} value={endYear} aria-describedby="hint-years" class={inputClass} />
          </div>
        </div>
        <p id="hint-years" class={hintClass}>Tussen {FIRST_YEAR} en {maxYear}.</p>
      </div>

      <div>
        <label for="select-month" class={labelClass}>Vergelijk op</label>
        <select id="select-month" name="maand" aria-describedby="hint-month" class={inputClass}>
          {MONTHS.map(([value, label]) => <option value={value} selected={value === month}>{label}</option>)}
        </select>
        <p id="hint-month" class={hintClass}>Dezelfde maand in beide jaren (vanaf {FIRST_MONTHLY_YEAR}), of het gemiddelde van het hele jaar.</p>
      </div>
    </div>
  </form>
</section>

<section class={`flex flex-col ${cardClass} bg-blue-50/40 p-6 lg:p-8`} aria-labelledby="result-title">
  <h2 id="result-title" class="text-xl font-bold">Resultaat</h2>
  <div id="result" class="mt-3 transition-opacity">
    <p class="text-gray-800">
      <span id="result-input" class="font-semibold">{result.input}</span> uit <span id="result-start-year">{startYear}</span> heeft in <span id="result-end-year">{endYear}</span> een koopkracht van
    </p>
    <p id="result-output" class="mt-1 text-4xl font-bold tracking-tight text-blue-900 lg:text-5xl">{result.output}</p>
    <p id="result-change" class="mt-4" hidden={fromYear === toYear}>
      Tussen <span id="result-from-year">{fromYear}</span> en <span id="result-to-year">{toYear}</span> <span id="result-direction">{result.direction}</span> de prijzen met <strong><span id="result-inflation">{result.inflation}</span>%</strong>,
      gemiddeld <strong><span id="result-average">{result.average}</span>%</strong> per jaar.
    </p>
    <p id="result-same-year" class="mt-4" hidden={fromYear !== toYear}>Begin- en eindjaar zijn hetzelfde, dus er is geen verschil in koopkracht.</p>
  </div>
  <p id="result-missing" class="mt-3" hidden></p>
  <p id="result-note" class="mt-3 text-sm text-gray-700" hidden></p>
  <p id="result-status" class="sr-only" role="status"></p>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <button id="share-result" type="button" class={`cursor-pointer rounded-md border border-blue-700 bg-white px-4 py-2 font-semibold text-blue-700 hover:bg-blue-50 ${focusRing}`}>
      Deel dit resultaat
    </button>
    <p id="share-feedback" class="text-sm text-gray-700" aria-live="polite"></p>
  </div>

  <p class="mt-6 text-sm text-gray-600">
    Bron: CBS, maandcijfers tot en met {data.latestMonthlyLabel} en jaarcijfers tot en met {data.latestYearlyYear} (bijgewerkt op <time datetime={datasetModified.toISOString()}>{updatedOn}</time>).
  </p>
</section>

<script type="application/json" id="cbs-data" set:html={embedJson(data.toCompact())} />

<script>
  import '../scripts/calculator';
</script>
