---
import {
  FIRST_MONTHLY_YEAR,
  FIRST_YEAR,
  MONTHS,
  formatAmount,
  formatMoney,
  formatPercent,
  type InflationData,
} from '../lib/inflation';
import type { CaoData } from '../lib/cao';
import { caoPeriodNote, comparedToCao, salaryComparison, wageComparison } from '../lib/salary';
import { cardClass, focusRing, hintClass, inputClass, labelClass } from '../lib/ui';

// The /salaris form and its result card, built the same way as
// Calculator.astro: two grid children, rendered as a complete static result
// from build-time CBS data (so search engines and no-JS visitors see real
// numbers) and made interactive by src/scripts/salary.ts, which reads the
// defaults back from the DOM and looks every element up by id.
//
// Only one of these per page, and never alongside <Calculator>: both embed
// the CBS data as <script id="cbs-data">, and both scripts assume their own
// ids are unique. See Invariants in AGENTS.md.
interface Props {
  data: InflationData;
  cao: CaoData;
  datasetModified: Date;
  caoModified: Date;
  amount: number;
  /**
   * Prefilling this would make the page assert a salary the visitor does not
   * have ("Je verdient nu € 3.600,00") before they have typed anything, so
   * the page leaves it out and the card shows a prompt instead.
   */
  currentSalary?: number;
  startYear: number;
  endYear: number;
  month: string;
  heading: string;
  headingTag?: 'h1' | 'h2';
  intro?: string;
}

const { data, cao, datasetModified, caoModified, amount, currentSalary, startYear, endYear, month, heading, headingTag: Heading = 'h1', intro } = Astro.props;

const maxYear = data.latestYear;
const modified = new Date(Math.max(datasetModified.getTime(), caoModified.getTime()));
const updatedOn = modified.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Amsterdam' });

// The defaults have to produce a complete result: the script updates the
// elements below by id and would find nothing to write into otherwise. A
// default that CBS has no figures for is a build error, not a blank card.
const comparison = salaryComparison(data, amount, startYear, endYear, month, currentSalary);
const wages = wageComparison(data, cao, startYear, endYear, month);

if (!comparison || !wages) {
  throw new Error(`SalaryCalculator defaults have no CBS figures: ${startYear} → ${endYear}, ${month}`);
}

const { required, inflation, average, actual } = comparison;


// `comparedToCao` is only ever shown for an exact period: over a fallback the
// two percentages cover different spans (see wageComparison).
const rose = (value: number) => (value < 0 ? 'daalden' : 'stegen');

// Without a current salary those two blocks are hidden, but their elements
// must still be in the HTML for the script to fill in later (see Invariants
// in AGENTS.md) — so the sentences render with their values left blank
// rather than with invented ones.
const keepUp = {
  salary: actual ? formatMoney(actual.salary, endYear) : '',
  gap: actual ? formatMoney(Math.abs(actual.gap), endYear) : '',
  gapDirection: actual && actual.gap < 0 ? 'minder' : actual ? 'meer' : '',
  real: actual ? formatPercent(Math.abs(actual.realChange)) : '',
  realDirection: actual && actual.realChange < 0 ? 'gedaald' : actual ? 'gestegen' : '',
  realValue: actual ? formatMoney(actual.realValue, startYear) : '',
  nominal: actual ? formatPercent(Math.abs(actual.nominalChange)) : '',
  nominalDirection: actual && actual.nominalChange < 0 ? 'daalde' : actual ? 'steeg' : '',
  compared: actual ? comparedToCao(actual.nominalChange, wages.cao) : '',
};

---

<section class={`flex flex-col ${cardClass}`} aria-labelledby="salary-calculator-title">
  <form id="salary-form" class="p-6 lg:p-8" novalidate>
    <Heading id="salary-calculator-title" class={Heading === 'h1' ? 'text-2xl font-bold' : 'text-xl font-bold'}>{heading}</Heading>
    {intro && <p class="mt-1 text-gray-700">{intro}</p>}

    <div class="mt-4 space-y-4">
      <div>
        <label for="salary-input-then" class={labelClass}>Salaris toen</label>
        <input id="salary-input-then" name="bedrag" type="text" inputmode="decimal" autocomplete="off" value={formatAmount(amount)} aria-describedby="salary-hint-then" class={inputClass} />
        <p id="salary-hint-then" class={hintClass}>Bruto of netto, per maand of per jaar — als je in beide velden hetzelfde soort bedrag invult.</p>
      </div>

      <div>
        <div class="grid grid-cols-[1fr_auto_1fr] items-end gap-2">
          <div>
            <label for="salary-input-start-year" class={labelClass}>Van jaar</label>
            <input id="salary-input-start-year" name="van" type="number" inputmode="numeric" min={FIRST_YEAR} max={maxYear} value={startYear} aria-describedby="salary-hint-years" class={inputClass} />
          </div>
          <button id="salary-switch-years" type="button" class={`flex size-11 cursor-pointer items-center justify-center rounded-md hover:bg-gray-100 ${focusRing}`} aria-label="Wissel de jaren om">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 rotate-90" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5L7.5 3m0 0L12 7.5M7.5 3v13.5m13.5 0L16.5 21m0 0L12 16.5m4.5 4.5V7.5" />
            </svg>
          </button>
          <div>
            <label for="salary-input-end-year" class={labelClass}>Naar jaar</label>
            <input id="salary-input-end-year" name="naar" type="number" inputmode="numeric" min={FIRST_YEAR} max={maxYear} value={endYear} aria-describedby="salary-hint-years" class={inputClass} />
          </div>
        </div>
        <p id="salary-hint-years" class={hintClass}>Tussen {FIRST_YEAR} en {maxYear}.</p>
      </div>

      <div>
        <label for="salary-input-now" class={labelClass}>Salaris nu <span class="font-normal text-gray-600">(optioneel)</span></label>
        <input id="salary-input-now" name="nu" type="text" inputmode="decimal" autocomplete="off" value={currentSalary === undefined ? '' : formatAmount(currentSalary)} aria-describedby="salary-hint-now" class={inputClass} />
        <p id="salary-hint-now" class={hintClass}>Vul in wat je nu verdient om te zien of je salaris de prijzen heeft bijgehouden.</p>
      </div>

      <div>
        <label for="salary-select-month" class={labelClass}>Vergelijk op</label>
        <select id="salary-select-month" name="maand" aria-describedby="salary-hint-month" class={inputClass}>
          {MONTHS.map(([value, label]) => <option value={value} selected={value === month}>{label}</option>)}
        </select>
        <p id="salary-hint-month" class={hintClass}>Dezelfde maand in beide jaren (vanaf {FIRST_MONTHLY_YEAR}), of het gemiddelde van het hele jaar.</p>
      </div>
    </div>
  </form>
</section>

<section class={`flex flex-col ${cardClass} bg-blue-50/40 p-6 lg:p-8`} aria-labelledby="salary-result-title">
  <h2 id="salary-result-title" class="text-xl font-bold">Resultaat</h2>
  <div id="salary-result" class="mt-3 transition-opacity">
    <p class="text-gray-800">
      Om in <span id="salary-result-end-year">{endYear}</span> net zoveel te kunnen kopen als met <span id="salary-result-then" class="font-semibold">{formatMoney(amount, startYear)}</span> in <span id="salary-result-start-year">{startYear}</span>, heb je nodig
    </p>
    <p id="salary-result-required" class="mt-1 text-4xl font-bold tracking-tight text-blue-900 lg:text-5xl">{formatMoney(required, endYear)}</p>

    <p id="salary-result-change" class="mt-4">
      Tussen <span id="salary-result-from-year">{Math.min(startYear, endYear)}</span> en <span id="salary-result-to-year">{Math.max(startYear, endYear)}</span> <span id="salary-result-direction">{rose(inflation)}</span> de prijzen met <strong><span id="salary-result-inflation">{formatPercent(Math.abs(inflation))}</span>%</strong>, gemiddeld <strong><span id="salary-result-average">{formatPercent(average)}</span>%</strong> per jaar.
    </p>
    <p id="salary-result-same-year" class="mt-4" hidden>Begin- en eindjaar zijn hetzelfde, dus er is geen verschil in koopkracht.</p>

    {/* Points at the field by its label, not by position: on lg the form is
        in the column beside this card, not above it. */}
    <p id="salary-keepup-prompt" class="mt-4 border-t border-blue-200 pt-4 text-gray-700" hidden={!!actual}>
      Vul bij “Salaris nu” in wat je verdient, dan zie je hoeveel dat scheelt.
    </p>

    <div id="salary-keepup" class="mt-4 border-t border-blue-200 pt-4" hidden={!actual}>
      <p>
        In <span id="salary-keepup-end-year">{endYear}</span> verdien je <strong><span id="salary-keepup-salary">{keepUp.salary}</span></strong>: <strong><span id="salary-keepup-gap">{keepUp.gap}</span> <span id="salary-keepup-gap-direction">{keepUp.gapDirection}</span></strong> dan nodig om dezelfde koopkracht te houden als in <span id="salary-keepup-start-year">{startYear}</span>.
      </p>
      <p class="mt-2">
        Je koopkracht is daarmee met <strong><span id="salary-keepup-real">{keepUp.real}</span>%</strong> <span id="salary-keepup-real-direction">{keepUp.realDirection}</span>. In geld van <span id="salary-keepup-start-year-2">{startYear}</span> is dat <strong><span id="salary-keepup-real-value">{keepUp.realValue}</span></strong>.
      </p>
    </div>

    <div id="salary-cao" class="mt-4 border-t border-blue-200 pt-4">
      <p>
        Tussen <span id="salary-cao-from-year">{wages.fromYear}</span> en <span id="salary-cao-to-year">{wages.toYear}</span> <span id="salary-cao-direction">{rose(wages.cao)}</span> de cao-lonen met <strong><span id="salary-cao-growth">{formatPercent(Math.abs(wages.cao))}</span>%</strong>, terwijl de prijzen met <strong><span id="salary-cao-prices">{formatPercent(Math.abs(wages.prices))}</span>%</strong> <span id="salary-cao-prices-direction">{rose(wages.prices)}</span>. Gecorrigeerd voor inflatie <span id="salary-cao-real-direction">{rose(wages.real)}</span> de cao-lonen dus met <strong><span id="salary-cao-real">{formatPercent(Math.abs(wages.real))}</span>%</strong>.
      </p>
      <p id="salary-cao-yours" class="mt-2" hidden={!actual}>
        Jouw salaris <span id="salary-cao-yours-direction">{keepUp.nominalDirection}</span> tussen <span id="salary-cao-yours-from">{Math.min(startYear, endYear)}</span> en <span id="salary-cao-yours-to">{Math.max(startYear, endYear)}</span> met <strong><span id="salary-cao-yours-growth">{keepUp.nominal}</span>%</strong><span id="salary-cao-yours-verdict" hidden={!actual || !wages.exact}>: <span id="salary-cao-yours-compared">{keepUp.compared}</span> dan de gemiddelde cao-loonstijging</span>.
      </p>
      <p id="salary-cao-note" class="mt-2 text-sm text-gray-700" hidden={wages.exact}>{caoPeriodNote(wages)}</p>
    </div>
  </div>
  <p id="salary-result-missing" class="mt-3" hidden></p>
  <p id="salary-result-note" class="mt-3 text-sm text-gray-700" hidden></p>
  <p id="salary-result-status" class="sr-only" role="status"></p>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <button id="salary-share" type="button" class={`cursor-pointer rounded-md border border-blue-700 bg-white px-4 py-2 font-semibold text-blue-700 hover:bg-blue-50 ${focusRing}`}>
      Deel dit resultaat
    </button>
    <p id="salary-share-feedback" class="text-sm text-gray-700" aria-live="polite"></p>
  </div>

  <p class="mt-6 text-sm text-gray-600">
    Bron: CBS. Prijzen tot en met {data.latestPeriodLabel}; cao-lonen tot en met {cao.latestPeriodLabel}, jaargemiddelden tot en met {cao.latestYearlyYear}. Bijgewerkt op <time datetime={modified.toISOString()}>{updatedOn}</time>.
  </p>
</section>

<script type="application/json" id="cbs-data" set:html={JSON.stringify(data.toCompact())} />
<script type="application/json" id="cao-data" set:html={JSON.stringify(cao.toCompact())} />

<script>
  import '../scripts/salary';
</script>
