# Redirects, honoured by Cloudflare Workers static assets:
# https://developers.cloudflare.com/workers/static-assets/redirects/

# The sitemap used to be at /sitemap.xml (Nuxt); @astrojs/sitemap writes
# sitemap-index.xml.
/sitemap.xml /sitemap-index.xml 301

# Otherwise Cloudflare's html_handling answers /index.html with a 307.
/index.html / 301

# Year pages without their trailing slash (Cloudflare would answer with a
# 307). Only the exact /<currency>/<year> form matches, not /…/<year>/.
/gulden/:year /gulden/:year/ 301
/euro/:year /euro/:year/ 301

# Same reason as the year pages: without this Cloudflare answers 307.
/salaris /salaris/ 301
